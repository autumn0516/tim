{
  "name": "示例模板",
  "description": "一个简单的视频模板示例",
  "version": "1.0.0",
  "settings": {
    "resolution": {
      "width": 1920,
      "height": 1080
    },
    "fps": 30,
    "duration": 15
  },
  "scenes": [
    {
      "id": "intro",
      "duration": 5,
      "background": {
        "type": "gradient",
        "color1": [0, 0, 0],
        "color2": [50, 50, 100]
      },
      "elements": [
        {
          "type": "text",
          "content": "标题文字",
          "position": "center",
          "font_size": 72,
          "color": "white",
          "animation": "fade_in"
        }
      ]
    },
    {
      "id": "content",
      "duration": 10,
      "background": {
        "type": "image",
        "source": "background.jpg"
      },
      "elements": [
        {
          "type": "text",
          "content": "内容描述",
          "position": "bottom",
          "font_size": 48
        }
      ]
    }
  ],
  "transitions": [
    {
      "from": "intro",
      "to": "content",
      "type": "fade",
      "duration": 1.0
    }
  ],
  "audio": {
    "background_music": "music.mp3",
    "volume": 0.7
  }
}
